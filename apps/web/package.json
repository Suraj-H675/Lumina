{
  "name": "@nova-lumina/web",
  "version": "0.0.0",
  "private": true,
  "description": "Nova-Lumina astronomy learning and exploration web application",
  "scripts": {
    "build": "next build && node ../../scripts/ci/check_wwt_bundle_isolation.mjs && node ../../scripts/ci/check_web_performance_budgets.mjs",
    "dev": "next dev",
    "lint": "eslint .",
    "start": "next start",
    "test": "vitest run --exclude tests/compute-performance.test.ts && vitest run tests/compute-performance.test.ts --maxWorkers=1 --no-file-parallelism",
    "test:e2e": "playwright test",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@nova-lumina/api-client": "workspace:*",
    "@wwtelescope/engine": "7.40.0",
    "@wwtelescope/engine-helpers": "0.18.0",
    "astronomy-engine": "2.1.19",
    "dexie": "4.4.6",
    "next": "16.3.6",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.62.1",
    "@nova-lumina/config-typescript": "workspace:*",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.6",
    "@types/jest-axe": "3.5.9",
    "@types/node": "24.10.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "fake-indexeddb": "6.2.5",
    "jest-axe": "11.0.0",
    "jsdom": "30.0.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
