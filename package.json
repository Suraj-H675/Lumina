{
  "name": "lumina",
  "version": "0.0.0",
  "private": true,
  "description": "Lumina repository workspace and accessible web foundation",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": "11.17.0"
  },
  "scripts": {
    "api:check": "uv run python scripts/openapi/generate_client.py check",
    "api:generate": "uv run python scripts/openapi/generate_client.py generate",
    "build": "pnpm --filter @lumina/web build",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run api:check && pnpm run manifests:check && pnpm run docs:check && pnpm run migrations:check",
    "dev": "pnpm --filter @lumina/web dev",
    "docs:check": "uv run python scripts/ci/check_doc_links.py",
    "format": "prettier --write . '!packages/api-client/openapi/openapi.json'",
    "format:check": "prettier --check . '!packages/api-client/openapi/openapi.json'",
    "lint": "pnpm --filter @lumina/api-client lint && pnpm --filter @lumina/web lint",
    "manifests:check": "uv run python scripts/data/validate_manifests.py",
    "migrations:check": "uv run python scripts/ci/check_migration_integrity.py",
    "security:check": "bash scripts/ci/check_security.sh",
    "test": "pnpm --filter @lumina/api-client test && pnpm --filter @lumina/web test",
    "test:e2e": "pnpm --filter @lumina/web test:e2e",
    "typecheck": "pnpm run typecheck:root && pnpm --filter @lumina/api-client typecheck && pnpm --filter @lumina/web typecheck",
    "typecheck:root": "tsc --project tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@lumina/config-typescript": "workspace:*",
    "prettier": "3.9.6",
    "typescript": "6.0.3"
  }
}
